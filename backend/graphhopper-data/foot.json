{
  "priority": [
    {
      "if": "road_class == FOOTWAY || road_class == PEDESTRIAN",
      "multiply_by": 1.5
    },
    {
      "if": "road_class == PATH",
      "multiply_by": 1.2
    },
    {
      "if": "road_class == STEPS",
      "multiply_by": 0.8
    },
    {
      "if": "road_class == RESIDENTIAL || road_class == LIVING_STREET",
      "multiply_by": 1.0
    },
    {
      "if": "road_class == SERVICE",
      "multiply_by": 0.9
    },
    {
      "if": "road_class == TERTIARY || road_class == TERTIARY_LINK",
      "multiply_by": 0.8
    }
  ],
  "speed": [
    {
      "if": "true",
      "limit_to": 5
    },
    {
      "if": "road_class == STEPS",
      "limit_to": 2
    }
  ]
} 