rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    
    function isGroupMember(groupId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
    }
    
    function isGroupAdmin(groupId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.admins;
    }
    
    function isGroupCreator(groupId) {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.creatorId;
    }
    

    
    // Users collection
    match /users/{userId} {
      // Allow reading for authenticated users
      allow read: if isAuthenticated();
      
      // Allow listing/querying for phone number existence checks (unauthenticated)
      allow list: if request.auth == null;
      
      // Allow creating user documents with UID as document ID
      allow create: if isOwner(userId);
      
      // Allow updates by the owner
      allow update: if isOwner(userId) && 
        (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['createdAt', 'uid']));
      
      // Allow friend-related updates when accepting friend requests
      // This allows adding/removing friends when only friends and updatedAt fields are modified
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['friends', 'updatedAt']);
      
      allow delete: if false;
    }
    
    // User addresses collection
    match /userAddresses/{addressId} {
      // Allow users to read/write their own addresses
      allow read, write: if isAuthenticated() && 
        (resource == null || resource.data.userId == request.auth.uid);
      
      // Allow authenticated users to read addresses when querying by userId
      // This enables group members to load each other's addresses for meeting point calculations
      // The application logic ensures this is only used within group contexts
      allow read: if isAuthenticated();
    }
    
    // Friend requests collection
    match /friendRequests/{requestId} {
      allow read: if isAuthenticated() && 
        (resource.data.senderId == request.auth.uid || 
         resource.data.recipientId == request.auth.uid);
      
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      allow update: if isAuthenticated() && (
        // Sender can cancel (update to 'canceled')
        (resource.data.senderId == request.auth.uid && 
         resource.data.status == 'pending' &&
         request.resource.data.status == 'canceled') ||
        // Recipient can accept or reject
        (resource.data.recipientId == request.auth.uid && 
         resource.data.status == 'pending' &&
         request.resource.data.status in ['accepted', 'rejected'])
      );
      
      allow delete: if false;
    }
    
    // Groups collection
    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);
      
      allow create: if isAuthenticated() && 
        request.resource.data.creatorId == request.auth.uid &&
        request.auth.uid in request.resource.data.members &&
        request.auth.uid in request.resource.data.admins;
      
      allow update: if (
        // Admins can update most fields
        (isGroupAdmin(groupId) && 
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['creatorId', 'createdAt', 'id'])) ||
        // Any group member can update meeting point
        (isGroupMember(groupId) &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['meetingPoint', 'updatedAt']))
      );
      
      allow delete: if isGroupCreator(groupId);
    }
    
    // Group memberships collection
    match /groupMemberships/{membershipId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isGroupMember(resource.data.groupId)
      );
      
      allow create: if isAuthenticated() && 
        isGroupMember(request.resource.data.groupId);
      
      allow update: if isAuthenticated() && (
        // Admins can update roles
        (isGroupAdmin(resource.data.groupId) && 
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'updatedAt', 'promotedAt', 'promotedBy', 'demotedAt', 'demotedBy'])) ||
        // Members can mark as inactive when leaving
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active', 'removedAt', 'removedBy', 'updatedAt'])) ||
        // Users can update their own address selection for the group
        (resource.data.userId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['selectedAddressId', 'updatedAt'])) ||
        // Admins can update address selections for group members (for fixing missing addresses)
        (isGroupAdmin(resource.data.groupId) &&
         request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['selectedAddressId', 'updatedAt']))
      );
      
      allow delete: if false;
    }
    
    // Group invites collection
    match /groupInvites/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.invitedBy == request.auth.uid ||
        isGroupMember(resource.data.groupId)
      );
      
      allow create: if isAuthenticated() && 
        isGroupMember(request.resource.data.groupId) &&
        request.resource.data.invitedBy == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      allow update: if isAuthenticated() && (
        // Invitee can accept or decline
        (resource.data.userId == request.auth.uid &&
         resource.data.status == 'pending' &&
         request.resource.data.status in ['accepted', 'declined']) ||
        // Inviter or admin can cancel
        ((resource.data.invitedBy == request.auth.uid || isGroupAdmin(resource.data.groupId)) &&
         resource.data.status == 'pending' &&
         request.resource.data.status == 'canceled')
      );
      
      allow delete: if false;
    }
    
    // Group attendance collection - NEW
    match /groupAttendance/{attendanceId} {
      allow read: if isAuthenticated() && 
        isGroupMember(resource.data.groupId);
      
      allow create: if isAuthenticated() && 
        isGroupMember(request.resource.data.groupId) &&
        request.resource.data.userId == request.auth.uid;
      
      allow update: if isAuthenticated() && 
        resource.data.userId == request.auth.uid &&
        isGroupMember(resource.data.groupId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isAttending', 'location', 'updatedAt']);
      
      allow delete: if isAuthenticated() && 
        isGroupAdmin(resource.data.groupId);
    }
  }
}